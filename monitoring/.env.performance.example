MYSQL_DATABASE=jaedaero_performance
MYSQL_USER=jaedaero
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_LOCAL_EXPORTER_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_GRAFANA_PASSWORD

# 성능 테스트에서 CODEF API를 호출하지 않더라도 애플리케이션 시작에 필요하다.
# 실제 CODEF 자격 증명 또는 로컬 전용 임의 문자열을 입력한다.
CODEF_CLIENT_ID=CHANGE_ME_CODEF_CLIENT_ID
CODEF_CLIENT_SECRET=CHANGE_ME_CODEF_CLIENT_SECRET

# openssl rand -base64 32 결과를 넣는다. 운영 키를 재사용하지 않는다.
APP_CRYPTO_MASTER_KEY_BASE64=CHANGE_ME_BASE64_32_BYTE_AES_KEY

# openssl rand -base64 32 결과를 넣는다.
JWT_SECRET=CHANGE_ME_BASE64_32_BYTE_SECRET
