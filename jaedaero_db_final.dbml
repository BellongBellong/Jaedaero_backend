  DIAMOND
}

Enum investment_badge_initial_preference_enum {
  SAFE
  BALANCED
  AGGRESSIVE
}

Enum investment_badge_badge_tier_enum {
  SAFE
  BALANCED
  AGGRESSIVE
}

Enum investment_badge_safe_grade_enum {
  BRONZE
