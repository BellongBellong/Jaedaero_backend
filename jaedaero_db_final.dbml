Enum strategy_application_applied_guidance_action_enum {
  START
  CONTINUE
  REDUCE
  PAUSE
  SAFE_FOCUS
}

Enum strategy_application_applied_investment_frequency_enum {
  WEEKLY
  MONTHLY
}

Enum mission_mission_type_enum {
  SAFE
  AGGRESSIVE
}

Enum mission_mission_category_enum {
  DAILY
  RECOMMENDED
  ONE_TIME
  EVENT
}

Enum mission_trigger_type_enum {
  NONE
  DAYS_TO_DISCHARGE
  LEAVE_SCHEDULED
  PAYDAY
}

Enum badge_mission_type_enum {
