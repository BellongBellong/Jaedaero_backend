Project JAEDAERO {
  database_type: 'MySQL'
  Note: 'jaedaero_db_final.sql schema through 2026-08-21'
}

Enum users_social_type_enum {
  KAKAO
  GOOGLE
}

Enum users_profile_image_enum {
  ARMY
  NAVY
  AIRFORCE
  MARINE
}

Enum users_profile_source_enum {
  GREEN
  OLIVE
  YELLOW
  ORANGE
  GRAY
  BLACK
}

Enum soldier_profile_soldier_type_enum {
  ARMY
  NAVY
  AIRFORCE
  MARINE
}

Enum goal_status_enum {
  ACTIVE
  COMPLETED
  ARCHIVED
}

Enum military_pay_policy_soldier_type_enum {
  ARMY
  NAVY
  AIRFORCE
  MARINE
}

Enum codef_connection_status_enum {
  ACTIVE
  DISCONNECTED
  ERROR
}

Enum codef_institution_connection_business_type_enum {
  BK
  ST
}

Enum codef_institution_connection_status_enum {
  ACTIVE
  DISCONNECTED
  ERROR
}

Enum connected_account_business_type_enum {
  BK
  ST
}

Enum connected_account_account_role_enum {
