<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jaedaero.domain.marketreport.mapper.DailyMarketReportSourceMapper">

    <sql id="dailyMarketReportSourceColumns">
        source_id, report_id, source_order, title, url, created_at
    </sql>

    <insert id="insert"
            parameterType="com.jaedaero.domain.marketreport.vo.DailyMarketReportSourceVo"
            useGeneratedKeys="true" keyProperty="sourceId">
        INSERT INTO daily_market_report_source (
            report_id, source_order, title, url
        ) VALUES (
            #{reportId}, #{sourceOrder}, #{title}, #{url}
        )
    </insert>

    <delete id="deleteByReportId">
        DELETE FROM daily_market_report_source
        WHERE report_id = #{reportId}
    </delete>

    <select id="findByReportId"
            resultType="com.jaedaero.domain.marketreport.vo.DailyMarketReportSourceVo">
        SELECT <include refid="dailyMarketReportSourceColumns"/>
        FROM daily_market_report_source
        WHERE report_id = #{reportId}
        ORDER BY source_order ASC, source_id ASC
    </select>
</mapper>
