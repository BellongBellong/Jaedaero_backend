<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jaedaero.domain.dashboard.mapper.DashboardMapper">

    <select id="findActualDischargeDateByUserId" resultType="java.time.LocalDate">
        SELECT discharge_date
        FROM soldier_profile
        WHERE user_id = #{userId}
    </select>
</mapper>
