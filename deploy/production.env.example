# Copy this file to .env on the EC2 server. Never commit the real .env file.
MYSQL_DATABASE=jaedaero
MYSQL_USER=jaedaero_app
MYSQL_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-long-random-password

# The hostname is the Docker Compose service name, not localhost.
DB_URL=jdbc:mysql://mysql:3306/jaedaero?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=jaedaero_app
DB_PASSWORD=change-me-to-the-same-value-as-MYSQL_PASSWORD

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
JWT_SECRET=
