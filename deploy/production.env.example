# Copy this file to .env on the EC2 server. Never commit the real .env file.
MYSQL_DATABASE=jaedaero
MYSQL_USER=jaedaero_app
MYSQL_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-long-random-password

# The hostname is the Docker Compose service name, not localhost.
DB_URL=jdbc:mysql://mysql:3306/jaedaero?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=jaedaero_app
DB_PASSWORD=change-me-to-the-same-value-as-MYSQL_PASSWORD

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
JWT_SECRET=

# Amazon ElastiCache Valkey private endpoint. Real credentials belong only in EC2 .env.
REDIS_HOST=your-cache-endpoint.apn2.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true
REDIS_STREAM_NOTIFICATION_KEY=stream:notification:v1
REDIS_STREAM_NOTIFICATION_GROUP=notification-fcm-group

# Keep false/true for the first deployment. Change to true/false after dry-run verification.
FCM_ENABLED=false
FCM_DRY_RUN=true
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Notification worker tuning defaults.
NOTIFICATION_BATCH_SIZE=500
NOTIFICATION_OUTBOX_BATCH_SIZE=100
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_CONSUMER_BATCH_SIZE=50
NOTIFICATION_FCM_MAX_ATTEMPTS=5
NOTIFICATION_PENDING_MIN_IDLE_MS=30000
